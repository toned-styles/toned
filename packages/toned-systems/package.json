{
  "name": "@toned/systems",
  "version": "1.0.0",
  "description": "Reusable Toned token vocabularies, including the base design-system vocabulary.",
  "keywords": [
    "design-system",
    "design-tokens",
    "styling",
    "toned"
  ],
  "homepage": "https://toned.style",
  "bugs": {
    "url": "https://github.com/toned-styles/toned/issues"
  },
  "license": "MIT",
  "author": "Artur Kenzhaev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toned-styles/toned.git",
    "directory": "packages/toned-systems"
  },
  "type": "module",
  "exports": {
    "./base": "./base/index.ts",
    "./defineCssToken": "./defineCssToken.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": ".dist",
    "linkDirectory": false
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "bun -e 'import(`@toned-config/build`)'"
  },
  "devDependencies": {
    "@toned-config/build": "workspace:*",
    "@toned-config/typescript": "workspace:*",
    "@toned/core": "workspace:~",
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "@toned/core": "workspace:~",
    "@types/react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
