{
  "name": "@toned/themes",
  "version": "1.0.0",
  "description": "Theme values for the @toned/systems base vocabulary.",
  "keywords": [
    "css-variables",
    "design-tokens",
    "shadcn",
    "theme",
    "toned"
  ],
  "homepage": "https://toned.style",
  "bugs": {
    "url": "https://github.com/toned-styles/toned/issues"
  },
  "license": "MIT",
  "author": "Artur Kenzhaev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toned-styles/toned.git",
    "directory": "packages/toned-themes"
  },
  "type": "module",
  "exports": {
    "./shadcn": "./shadcn/config.ts",
    "./shadcn/config.css": "./shadcn/config.css"
  },
  "publishConfig": {
    "access": "public",
    "directory": ".dist",
    "linkDirectory": false
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "bun -e 'import(`@toned-config/build`)'"
  },
  "devDependencies": {
    "@toned-config/build": "workspace:*",
    "@toned-config/typescript": "workspace:*"
  }
}
