    "url": "git+https://github.com/lttb/toned.git",
    "directory": "@toned/core"
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "bun --bun -e 'import(`@toned-config/build`)'"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@toned-config/build": "workspace:*",
    "@toned-config/typescript": "workspace:*",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "csstype": "^3.2.3"
  }
