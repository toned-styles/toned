{
  "name": "@toned/compiler",
  "devDependencies": {
    "@toned-config/typescript": "workspace:*",
    "@toned-config/build": "workspace:*",
    "@types/node": "catalog:"
  },
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./model": "./model.ts",
    "./contracts": "./contracts/index.ts",
    "./tokens": "./tokens/index.ts",
    "./lsp": "./lsp/index.ts",
    "./inspector": "./inspector/index.ts",
    "./workspace": "./workspace.ts",
    "./bridge": "./bridge/index.ts"
  },
  "bin": {
    "toned": "./cli.ts",
    "toned-lsp": "./lsp/cli.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": ".dist",
    "linkDirectory": false
  },
  "scripts": {
    "build": "bun --bun -e 'import(`@toned-config/build`)'"
  },
  "dependencies": {
    "@toned/core": "workspace:~",
    "typescript": "5.9.3",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  }
}
