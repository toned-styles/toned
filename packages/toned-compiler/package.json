{
  "name": "@toned/compiler",
  "version": "0.1.0",
  "description": "Source index, language server, CLI and source-editing tools for Toned declarations.",
  "keywords": [
    "codemod",
    "design-tokens",
    "dtcg",
    "language-server",
    "lsp",
    "toned"
  ],
  "homepage": "https://toned.style",
  "bugs": {
    "url": "https://github.com/toned-styles/toned/issues"
  },
  "license": "MIT",
  "author": "Artur Kenzhaev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toned-styles/toned.git",
    "directory": "packages/toned-compiler"
  },
  "bin": {
    "toned": "./cli.ts",
    "toned-lsp": "./lsp/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./model": "./model.ts",
    "./contracts": "./contracts/index.ts",
    "./tokens": "./tokens/index.ts",
    "./lsp": "./lsp/index.ts",
    "./language-service": "./language-service.ts",
    "./inspector": "./inspector/index.ts",
    "./workspace": "./workspace.ts",
    "./bridge": "./bridge/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": ".dist",
    "linkDirectory": false
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "bun --bun -e 'import(`@toned-config/build`)'"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@toned/core": "workspace:~",
    "typescript": "~6.0.3",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15"
  },
  "devDependencies": {
    "@toned-config/build": "workspace:*",
    "@toned-config/typescript": "workspace:*",
    "@types/node": "catalog:"
  }
}
