{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "sortImports": {},
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/CHANGELOG.md",
    "**/.dist/**",
    "**/.tsc/**",
    "**/routeTree.gen.ts",
    "benchmarks/**/*.json"
  ],
  "overrides": [
    {
      "files": ["*.css"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
